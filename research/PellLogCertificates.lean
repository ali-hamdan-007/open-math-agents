import RationalLogBounds
import Mathlib.Analysis.Real.Sqrt

/-! Explicit 1000-digit enclosures for two logarithms of Pell bases. -/

namespace PellLogCertificates

def denominator : ℕ := 10 ^ 1030

private theorem denominator_pos : 0 < denominator := by unfold denominator; positivity

def twoSqrtThreeLogLower : ℕ :=
  

def twoSqrtThreeLogUpper : ℕ :=
  

private def twoSqrtThreeArgLower : ℕ :=
  

private def twoSqrtThreeArgUpper : ℕ :=
  

set_option maxRecDepth 10000 in
set_option maxHeartbeats 10000000 in
theorem twoSqrtThree :
    2 * ((twoSqrtThreeLogLower : ℝ) / denominator) ≤ Real.log (2 + Real.sqrt 3) ∧
    Real.log (2 + Real.sqrt 3) ≤ 2 * ((twoSqrtThreeLogUpper : ℝ) / denominator) := by
  have hD : (0 : ℝ) < denominator := by exact_mod_cast denominator_pos
  have hDq : (0 : ℚ) < denominator := by exact_mod_cast denominator_pos
  have hArgLower : ((↑((twoSqrtThreeArgLower : ℚ) / denominator)) : ℝ) ≤
      2 + Real.sqrt 3 := by
    push_cast
    have hfrac : (0 : ℝ) ≤ (twoSqrtThreeArgLower : ℝ) / denominator - 2 := by
      apply sub_nonneg_of_le
      apply (le_div_iff₀ hD).mpr
      exact_mod_cast (show 2 * denominator ≤ twoSqrtThreeArgLower by decide +kernel)
    have hsquare : ((twoSqrtThreeArgLower : ℝ) / denominator - 2) ^ 2 ≤ 3 := by
      rw [show (twoSqrtThreeArgLower : ℝ) / denominator - 2 =
          ((twoSqrtThreeArgLower : ℝ) - 2 * denominator) / denominator by
        field_simp]
      rw [div_pow, div_le_iff₀ (by positivity : 0 < (denominator : ℝ) ^ 2)]
      exact_mod_cast (show ((twoSqrtThreeArgLower : ℤ) - 2 * denominator) ^ 2 ≤
        3 * (denominator : ℤ) ^ 2 by decide +kernel)
    have := (Real.le_sqrt hfrac (by norm_num)).mpr hsquare
    linarith
  have hArgUpper : 2 + Real.sqrt 3 ≤
      ((↑((twoSqrtThreeArgUpper : ℚ) / denominator)) : ℝ) := by
    push_cast
    have hfrac : (0 : ℝ) ≤ (twoSqrtThreeArgUpper : ℝ) / denominator - 2 := by
      apply sub_nonneg_of_le
      apply (le_div_iff₀ hD).mpr
      exact_mod_cast (show 2 * denominator ≤ twoSqrtThreeArgUpper by decide +kernel)
    have hsquare : (3 : ℝ) ≤ ((twoSqrtThreeArgUpper : ℝ) / denominator - 2) ^ 2 := by
      rw [show (twoSqrtThreeArgUpper : ℝ) / denominator - 2 =
          ((twoSqrtThreeArgUpper : ℝ) - 2 * denominator) / denominator by
        field_simp]
      rw [div_pow, le_div_iff₀ (by positivity : 0 < (denominator : ℝ) ^ 2)]
      exact_mod_cast (show 3 * (denominator : ℤ) ^ 2 ≤
        ((twoSqrtThreeArgUpper : ℤ) - 2 * denominator) ^ 2 by decide +kernel)
    have := Real.sqrt_le_iff.mpr ⟨hfrac, hsquare⟩
    linarith
  simpa only [Nat.cast_ofNat] using RationalLogBounds.fixedEnclosure
    (a := (twoSqrtThreeArgLower : ℚ) / denominator) (b := (twoSqrtThreeArgUpper : ℚ) / denominator)
    (p := twoSqrtThreeLogLower) (q := twoSqrtThreeLogUpper) (D := denominator) (n := 520) 2
    denominator_pos (by decide) (by decide +kernel)
    (div_pos (by exact_mod_cast (show 0 < twoSqrtThreeArgLower by decide)) hDq) hArgLower hArgUpper
    (by decide +kernel) (by decide +kernel)
#print axioms twoSqrtThree
