    (p := threeSqrtEightLogLower) (q := threeSqrtEightLogUpper) (D := denominator) (n := 520) 2
    denominator_pos (by decide) (by decide +kernel)
    (div_pos (by exact_mod_cast (show 0 < threeSqrtEightArgLower by decide)) hDq) hArgLower hArgUpper
    (by decide +kernel) (by decide +kernel)
