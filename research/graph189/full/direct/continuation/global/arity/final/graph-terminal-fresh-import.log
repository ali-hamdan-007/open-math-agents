Graph189TerminalGraph.exists_valid_band.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] [Nontrivial V]
  {G : SimpleGraph V} [DecidableRel G.Adj] (hc : G.Connected)
  (hcap : (Finset.image G.distEven Finset.univ).max' ⋯ ≤ 1 + G.secondSmallestDegree) (hn : ¬∃ a b p, p.IsHamiltonian)
  (hsN : 5 ≤ G.vertexConnectivity) (hk26N : 26 ≤ G.secondSmallestDegree)
  (hkN : 3 * G.vertexConnectivity < G.secondSmallestDegree) :
  have s := ↑G.vertexConnectivity;
  have k := ↑G.secondSmallestDegree;
  have n := ↑(Fintype.card V);
  have d := ↑(Graph189EffectiveDeficit.effectiveDeficit G);
  (s + 1) * (k - s + 2) - 1 ≤ n →
    (3 * s < 2 * (k - d - 1) → 2 * s ≤ k - 2 * d - 2 → 4 * n < k * (k - 1) → (s + 2) * (k - d - s + 1) - 1 ≤ n) →
      ∃ r, r.s = s ∧ r.k = k ∧ r.low ≤ n ∧ Graph189FiniteDomain.valid r = true
'Graph189TerminalGraph.exists_valid_band' depends on axioms: [propext, Classical.choice, Quot.sound]
