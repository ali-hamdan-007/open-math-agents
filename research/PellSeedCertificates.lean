import SeedLogLemma
import PellLogCertificates

namespace PellSeedCertificates

open PellLogCertificates (denominator)

private theorem denominator_pos : 0 < denominator := by unfold denominator; positivity

private def sqrt3Floor : ℕ := 
private def sqrt8Floor : ℕ := 
def seedThreeLogLower : ℕ :=
  

def seedThreeLogUpper : ℕ :=
  

set_option maxRecDepth 10000 in
set_option maxHeartbeats 10000000 in
theorem seedThree :
    2 * ((seedThreeLogLower : ℝ) / denominator) ≤
      Real.log (1 + 1 / Real.sqrt 3) ∧
    Real.log (1 + 1 / Real.sqrt 3) ≤
      2 * ((seedThreeLogUpper : ℝ) / denominator) := by
  simpa only [Nat.cast_ofNat, Nat.cast_one] using SeedLogLemma.reciprocalSqrt
    (d := 3) (u := 1) (v := 1) (r := sqrt3Floor) (p := seedThreeLogLower)
    (q := seedThreeLogUpper) (D := denominator) (n := 520) denominator_pos
    (by decide) (by decide +kernel) (by decide) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)

#print axioms seedThree
