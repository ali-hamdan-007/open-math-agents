import Erdos307OmittedPrime

namespace Erdos307Structure

open Finset

/-- Any common exponent of the squared support residues suffices for the
Dickson trace test. For an omitted prime, one can take the order of the
subgroup generated by the squared support residues. -/
theorem dickson_support_exponent {P Q : Finset ℕ} {modulus exponent : ℕ}
    (hP : ∀ p ∈ P, p.Prime) (hQ : ∀ q ∈ Q, q.Prime)
    (hannihilate : ∀ p ∈ P ∪ Q, ((p : ZMod modulus)^2)^exponent = 1)
    (heq : 1 = (∑ p ∈ P, (p : ℚ)⁻¹) * (∑ q ∈ Q, (q : ℚ)⁻¹)) :
    dicksonTrace (numer (P ∪ Q) : ZMod modulus)
      ((denom (P ∪ Q) : ZMod modulus)^2) exponent = 2 := by
  have hpair {U : Finset ℕ} (hU : ∀ u ∈ U, u.Prime) :
      Set.Pairwise (U : Set ℕ) Nat.Coprime :=
    fun _ hx _ hy hxy => (Nat.coprime_primes (hU _ hx) (hU _ hy)).mpr hxy
  obtain ⟨hpq, hqp, hcross⟩ := swap_products P Q
    (fun p hp => (hP p hp).pos) (fun q hq => (hQ q hq).pos) (hpair hP) (hpair hQ) heq
  have hdis : Disjoint P Q := by
    apply Finset.disjoint_left.mpr
    intro x hx hy
    have hc := hcross x hx x hy
    rw [Nat.Coprime, Nat.gcd_self] at hc
    exact (hP x hx).ne_one hc
  have hpow {U : Finset ℕ} (hU : U ⊆ P ∪ Q) :
      (((denom U : ZMod modulus)^2)^exponent) = 1 := by
    rw [denom, Nat.cast_prod, ← Finset.prod_pow, ← Finset.prod_pow]
    simpa using (Finset.prod_congr rfl (fun p hp => hannihilate p (hU hp)))
  have hN : denom (P ∪ Q) = denom Q * denom P :=
    (Finset.prod_union hdis).trans (mul_comm _ _)
  rw [numer_union_of_disjoint hdis, hpq, hqp, hN, Nat.cast_add,
    Nat.cast_mul, Nat.cast_mul, Nat.cast_mul, mul_pow, ← pow_two, ← pow_two,
    dicksonTrace_add_mul, hpow (subset_union_left (s₂ := Q)),
    hpow (subset_union_right (s₁ := P))]
  ring

/-- The subgroup generated by the squares of the nonzero support residues. -/
def supportSquareSubgroup (S : Finset ℕ) (ell : ℕ) : Subgroup (ZMod ell)ˣ :=
  Subgroup.closure {u | ∃ p ∈ S, (u : ZMod ell) = (p : ZMod ell)^2}

/-- At an omitted prime, restrict the exponent to the order of the subgroup
generated by the squares of the support residues. -/
theorem dickson_support_subgroup {P Q : Finset ℕ} {ell : ℕ} [Fact ell.Prime]
    (hP : ∀ p ∈ P, p.Prime) (hQ : ∀ q ∈ Q, q.Prime)
    (hout : ell ∉ P ∪ Q)
    (heq : 1 = (∑ p ∈ P, (p : ℚ)⁻¹) * (∑ q ∈ Q, (q : ℚ)⁻¹)) :
    dicksonTrace (numer (P ∪ Q) : ZMod ell) ((denom (P ∪ Q) : ZMod ell)^2)
      (Nat.card (supportSquareSubgroup (P ∪ Q) ell)) = 2 := by
  apply dickson_support_exponent hP hQ _ heq
  intro p hp
  have hprime : p.Prime := (mem_union.mp hp).elim (hP p) (hQ p)
  have hne : (p : ZMod ell) ≠ 0 := by
    intro hz
    rcases (Nat.dvd_prime hprime).mp ((ZMod.natCast_eq_zero_iff _ _).mp hz) with h | h
    · exact (Fact.out : ell.Prime).ne_one h
    · exact hout (h ▸ hp)
  let unit := Units.mk0 ((p : ZMod ell)^2) (pow_ne_zero _ hne)
  have hmem : unit ∈ supportSquareSubgroup (P ∪ Q) ell :=
    Subgroup.subset_closure ⟨p, hp, rfl⟩
  let x : supportSquareSubgroup (P ∪ Q) ell := ⟨unit, hmem⟩
  have h := congrArg (fun y : supportSquareSubgroup (P ∪ Q) ell =>
    ((y : (ZMod ell)ˣ) : ZMod ell)) (pow_card_eq_one' (x := x))
  simpa only [Subgroup.coe_pow, Units.val_pow_eq_pow_val, Subgroup.coe_one, Units.val_one, x, unit, Units.val_mk0] using h

private def strictSupport : Finset ℕ := {11, 41, 101}

/-- The strict example passes the internal cofactor-square tests. -/
theorem strictSupport_internal : ∀ p ∈ strictSupport,
    ∃ root : ZMod p, root ^ 2 = (denom strictSupport / p : ℕ) := by
  intro p hp
  simp [strictSupport] at hp
  rcases hp with rfl | rfl | rfl
  · exact ⟨4, by decide⟩
  · exact ⟨2, by decide⟩
  · exact ⟨42, by decide⟩

/-- At 5 the ambient paired-square conditions hold, yet the support squares
generate the trivial subgroup and its Dickson test fails at exponent 1. -/
theorem strictSupport_refinement :
    (∀ p ∈ strictSupport, p.Prime) ∧ 5 ∉ strictSupport ∧
    (∀ p ∈ strictSupport, (p : ZMod 5)^2 = 1) ∧
    (∃ u v : ZMod 5, u^2 = (numer strictSupport : ZMod 5) + 2 * (denom strictSupport : ZMod 5) ∧
        v^2 = (numer strictSupport : ZMod 5) - 2 * (denom strictSupport : ZMod 5)) ∧
    dicksonTrace (numer strictSupport : ZMod 5) ((denom strictSupport : ZMod 5)^2) 1 ≠ 2 := by
  refine ⟨?_, by decide, ?_, ⟨0, 1, by decide, by decide⟩, by decide⟩
  · intro p hp
    simp [strictSupport] at hp
    rcases hp with rfl | rfl | rfl <;> decide
  · intro p hp
    simp [strictSupport] at hp
    rcases hp with rfl | rfl | rfl <;> decide

#print axioms dickson_support_exponent
#print axioms dickson_support_subgroup
#print axioms strictSupport_internal
#print axioms strictSupport_refinement

end Erdos307Structure
