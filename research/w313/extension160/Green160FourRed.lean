private def seedMask : List Nat → Nat
  | [] => 2 ^ 160 - 1
  | p :: ps => pvAfter ps (seedMask ps) p

private theorem seedMask_safe {r : Nat → Bool} (hn : ¬ Mono r)
    (ps : List Nat) (hs : ∀ p ∈ ps, Red r p) (x : Nat) (hx : Red r x) :
    (seedMask ps).testBit x = true := by
  induction ps with
  | nil =>
    have full : ∀ i : Fin 160, (2 ^ 160 - 1 : Nat).testBit i.val = true := by
      decide +kernel
    exact full ⟨x, hx.1⟩
  | cons p ps ih =>
    have hp : Red r p := hs p (by simp)
    have hps : ∀ q ∈ ps, Red r q := fun q hq => hs q (by simp [hq])
    exact pv_safe (noTriple hn) hps (fun _ hq => hq.1) hp hx (ih hps)

/-- Four fixed red points suffice to force a 3-term red or 13-term blue progression. -/
theorem four_red_forces_progression (r : Nat → Bool)
    (red : ∀ x ∈ [66,70,71,98], r x = false) : Mono r := by
  apply Classical.byContradiction
  intro hn
  have known : ∀ x ∈ [98,71,70,66], Red r x := by
    intro x hx
    have hcases : x = 98 ∨ x = 71 ∨ x = 70 ∨ x = 66 := by simpa using hx
    rcases hcases with rfl | rfl | rfl | rfl <;> exact ⟨by decide, red _ (by decide)⟩
  apply v124 (Red r) (noTriple hn) (hits hn) (fun _ h => h.1) known
  have he : seedMask [98,71,70,66] = 0xfffffffb9fffffffffebeacf9fffebfbffffffff := by
    decide +kernel
  rw [← he]
  exact fun x hx => seedMask_safe hn _ known x hx

/-- Reflection gives a second branch specifying four red points. -/
theorem reflected_four_red_forces_progression (r : Nat → Bool)
    (red : ∀ x ∈ [61,88,89,93], r x = false) : Mono r := by
  apply reflect_progression
  apply four_red_forces_progression
  intro x hx
  have hcases : x = 66 ∨ x = 70 ∨ x = 71 ∨ x = 98 := by simpa using hx
  rcases hcases with rfl | rfl | rfl | rfl <;> exact red _ (by decide)

end OMA.Green160NearWitness

#print axioms OMA.Green160NearWitness.four_red_forces_progression
#print axioms OMA.Green160NearWitness.reflected_four_red_forces_progression
