private def seedMask : List Nat → Nat
  | [] => 2 ^ 150 - 1
  | p :: ps => pvAfter ps (seedMask ps) p

private theorem seedMask_safe {r : Nat → Bool} (hn : ¬ Mono r)
    (ps : List Nat) (hs : ∀ p ∈ ps, Red r p) (x : Nat) (hx : Red r x) :
    (seedMask ps).testBit x = true := by
  induction ps with
  | nil =>
    have full : ∀ i : Fin 150, (2 ^ 150 - 1 : Nat).testBit i.val = true := by
      decide +kernel
    exact full ⟨x, hx.1⟩
  | cons p ps ih =>
    have hp : Red r p := hs p (by simp)
    have hps : ∀ q ∈ ps, Red r q := fun q hq => hs q (by simp [hq])
    exact pv_safe (noTriple hn) hps (fun _ hq => hq.1) hp hx (ih hps)

/-- The checked 150-point coloring branch. -/
theorem window_forces_progression (r : Nat → Bool)
    (red : ∀ x ∈ [14, 16, 26, 28], r x = false) : Mono r := by
  apply Classical.byContradiction
  intro hn
  have known : ∀ x ∈ [28, 26, 16, 14], Red r x := by
    intro x hx
    have hcases : x = 28 ∨ x = 26 ∨ x = 16 ∨ x = 14 := by simpa using hx
    rcases hcases with rfl | rfl | rfl | rfl <;> exact ⟨by decide, red _ (by decide)⟩
  apply v186 (Red r) (noTriple hn) (hits hn) (fun _ h => h.1) known
  have he : seedMask [28, 26, 16, 14] = 0x3ffffffffffffffffffffffffffaafb68b6faa := by decide +kernel
  rw [← he]
  exact fun x hx => seedMask_safe hn _ known x hx

/-- A translated 150-point window fits in the 160-point interval for offsets 0 through 10. -/
theorem shifted_forces_progression (r : Nat → Bool) (s : Nat) (hs : s ≤ 10)
    (red : ∀ x ∈ [14, 16, 26, 28], r (s + x) = false) : OMA.Green160NearWitness.Mono r := by
  obtain ⟨b,a,d,hd,hend,hmono⟩ := window_forces_progression (fun i => r (s+i)) red
  refine ⟨b,s+a,d,hd,?_,?_⟩
  · omega
  · intro t ht
    simpa only [Nat.add_assoc] using hmono t ht

/-- Reflecting the translated windows gives a second family of forbidden red sets. -/
theorem reflected_shifted_forces_progression (r : Nat → Bool) (s : Nat) (hs : s ≤ 10)
    (red : ∀ x ∈ [14, 16, 26, 28], r (159 - (s + x)) = false) :
    OMA.Green160NearWitness.Mono r :=
  OMA.Green160NearWitness.reflect_progression r
    (shifted_forces_progression (fun i => r (159 - i)) s hs red)

end OMA.Green150Window.Seed14

#print axioms OMA.Green150Window.Seed14.shifted_forces_progression
#print axioms OMA.Green150Window.Seed14.reflected_shifted_forces_progression
