private def seedMask : List Nat → Nat
  | [] => 2 ^ @WIDTH@ - 1
  | p :: ps => pvAfter ps (seedMask ps) p

private theorem seedMask_safe {r : Nat → Bool} (hn : ¬ Mono r)
    (ps : List Nat) (hs : ∀ p ∈ ps, Red r p) (x : Nat) (hx : Red r x) :
    (seedMask ps).testBit x = true := by
  induction ps with
  | nil =>
    have full : ∀ i : Fin @WIDTH@, (2 ^ @WIDTH@ - 1 : Nat).testBit i.val = true := by
      decide +kernel
    exact full ⟨x, hx.1⟩
  | cons p ps ih =>
    have hp : Red r p := hs p (by simp)
    have hps : ∀ q ∈ ps, Red r q := fun q hq => hs q (by simp [hq])
    exact pv_safe (noTriple hn) hps (fun _ hq => hq.1) hp hx (ih hps)

/-- The checked @WIDTH@-point coloring branch. -/
theorem window_forces_progression (r : Nat → Bool)
    (red : ∀ x ∈ @ORDERED@, r x = false) : Mono r := by
  apply Classical.byContradiction
  intro hn
  have known : ∀ x ∈ @REVERSED@, Red r x := by
    intro x hx
    have hcases : @CASES@ := by simpa using hx
    rcases hcases with @POINTS@ <;> exact ⟨by decide, red _ (by decide)⟩
  apply @LAST@ (Red r) (noTriple hn) (hits hn) (fun _ h => h.1) known
  have he : seedMask @REVERSED@ = @MASK@ := by decide +kernel
  rw [← he]
  exact fun x hx => seedMask_safe hn _ known x hx

/-- A translated @WIDTH@-point window fits in the 160-point interval for offsets 0 through @SHIFT@. -/
theorem shifted_forces_progression (r : Nat → Bool) (s : Nat) (hs : s ≤ @SHIFT@)
    (red : ∀ x ∈ @ORDERED@, r (s + x) = false) : OMA.Green160NearWitness.Mono r := by
  obtain ⟨b,a,d,hd,hend,hmono⟩ := window_forces_progression (fun i => r (s+i)) red
  refine ⟨b,s+a,d,hd,?_,?_⟩
  · omega
  · intro t ht
    simpa only [Nat.add_assoc] using hmono t ht

/-- Reflecting the translated windows gives a second family of forbidden red sets. -/
theorem reflected_shifted_forces_progression (r : Nat → Bool) (s : Nat) (hs : s ≤ @SHIFT@)
    (red : ∀ x ∈ @ORDERED@, r (159 - (s + x)) = false) :
    OMA.Green160NearWitness.Mono r :=
  OMA.Green160NearWitness.reflect_progression r
    (shifted_forces_progression (fun i => r (159 - i)) s hs red)
