  have first : m ≤ pos 0 := by
    by_cases h : t < mark 0
    · simp [pos,h]
    obtain ⟨a,q,hq,dis,order⟩ := before
    have bound := protected_prefix_of_detour p hp t longest (mark 0) (le_of_not_gt h)
