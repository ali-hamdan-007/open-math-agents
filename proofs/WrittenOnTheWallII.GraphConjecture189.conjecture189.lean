    obtain ⟨a,ha,b,hb,ne⟩ := one_lt_card.mp (size i)
    have bounded (x : V) (hx : x∈W i) : G.degree x+1 ≤ S.card+(W i).card := by
      have sub : insert x (G.neighborFinset x) ⊆ S∪W i := by
        intro y hy
