  have hxi' : l.getD i₀ x₀ = x₀ := by rw [List.getD_eq_getElem _ _ hi₀]; exact hxi
  have hi0pos : i₀ ≠ 0 := by
    intro h; subst h; apply hhd; rw [b15_head hne x₀]; exact hxi'
  have hi0last : i₀ ≠ l.length - 1 := by
    intro h; apply hlast; rw [b15_last hne x₀, ← h]; exact hxi'
