    (s : List V) (hs : s ≠ []) (snd : s.Nodup) (sch : s.IsChain G.Adj) (sl : ∀ v ∈ s, v ∉ l) (b : ℕ) (hb' : b < l.length) (h : G.Adj (l.getD b x₀) (s.head hs))
    (hx : ∀ i, b < i → i < l.length → l.getD i x₀ ≠ x₀) (hlen : l.length - 1 - b < s.length) :
