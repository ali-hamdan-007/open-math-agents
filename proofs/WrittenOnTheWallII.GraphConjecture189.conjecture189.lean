      rw [hR]; simp [Finset.card_insert_of_notMem, d1, d2, d3, d4, d5, d6]
    have hham : ∀ y ∈ (Finset.univ.filter (fun t => t ∉ l)), ∃ s : List V, s.Nodup ∧
