    obtain ⟨h,eq⟩ := (mem x i).mp hx
    have adj : H.Adj ⟨x,h⟩ ⟨y,out⟩ := edge
    exact no ((mem y i).mpr ⟨out,(ConnectedComponent.connectedComponentMk_eq_of_adj adj).symm.trans eq⟩)
