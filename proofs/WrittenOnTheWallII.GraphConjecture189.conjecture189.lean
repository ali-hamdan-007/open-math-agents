      chain_sub (chain_sub hch (List.drop_suffix _ _).isInfix) (List.take_prefix _ _).isInfix,
      fun z hz => List.mem_toFinset.mpr (List.mem_of_mem_drop (List.mem_of_mem_take hz)), ?_, ?_⟩
