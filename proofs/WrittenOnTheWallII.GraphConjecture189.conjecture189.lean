    rw [hx] at hd
    have hsub : (l.take p ++ l.getD p x₀ :: x₀ :: l.drop q).Sublist
        (l.take p ++ l.getD p x₀ :: x₀ :: l.drop (p + 2)) :=
      List.Sublist.append (List.Sublist.refl _)
        (List.Sublist.cons₂ _ (List.Sublist.cons₂ _ (List.drop_sublist_drop_left l (by omega))))
    rw [← hd] at hsub
