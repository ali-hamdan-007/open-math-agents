variable {V : Type*} {G : SimpleGraph V}
theorem walk_exits (P : V → Prop) {x y : V} (p : G.Walk x y) (hx : P x) (hy : ¬ P y) :
    ∃ u v, P u ∧ ¬ P v ∧ G.Adj u v ∧ v ∈ p.support := by
