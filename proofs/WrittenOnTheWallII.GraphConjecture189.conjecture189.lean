  obtain ⟨a, b, hab, hbl, ⟨y, hy, hya⟩, ⟨y', hy', hyb⟩⟩ :=
    Cadre.two_attach hconn hb hH hmin hx0 hδ hne hnd hch hmem hhd hlast hmax hlt
