    (hδ : ∀ v, 2 ≤ G.degree v) (hne : l ≠ []) (hnd : l.Nodup) (hch : l.IsChain G.Adj)
    (hmem : x₀ ∈ l) (hhd : l.head hne ≠ x₀) (hlast : l.getLast hne ≠ x₀)
    (hmax : ∀ l' : List V, l'.Nodup → l'.IsChain G.Adj → x₀ ∈ l' → l'.length ≤ l.length)
