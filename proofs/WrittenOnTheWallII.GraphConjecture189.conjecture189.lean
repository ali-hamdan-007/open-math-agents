theorem path_of_cycle [Fintype V] [Nontrivial V] [DecidableRel G.Adj]
    (p : G.Walk x y) (hp : p.IsPath)
    (longest : ∀ {u v}, ∀ q : G.Walk u v, q.IsPath → q.length ≤ p.length)
    (conn : 2 ≤ G.vertexConnectivity) {r : V} (C : G.Walk r r) (hc : C.IsCycle)
