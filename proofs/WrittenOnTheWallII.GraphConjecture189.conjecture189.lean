        · simp [List.isChain_cons_cons, h1, h1.symm, h2, h2.symm, h3, h3.symm, h4, h4.symm]
        · ext t; simp <;> tauto
        · simp
      · refine ⟨[a, z, b, z'], ?_, ?_, ?_, ?_⟩
        · simp [d1, d2, d3, d4, d5, d6, Ne.symm d1, Ne.symm d2, Ne.symm d3, Ne.symm d4,
