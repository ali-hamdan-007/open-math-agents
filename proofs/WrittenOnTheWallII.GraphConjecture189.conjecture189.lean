    (hRQ : Q + 4 ≤ l.length ∨ Q < i₀) (hM : P + 2 ≤ Q ∧ (P + 4 ≤ Q ∨ (P < i₀ ∧ i₀ < Q)))
    (hi₀ : l.getD i₀ x₀ = x₀)
