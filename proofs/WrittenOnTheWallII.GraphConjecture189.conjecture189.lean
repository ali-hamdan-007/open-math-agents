    have hlt : t % C.length < C.length := Nat.mod_lt _ (by omega)
    have hm : (t + 1) % C.length = (t % C.length + 1) % C.length := by
      rw [Nat.add_mod, Nat.mod_eq_of_lt (show 1 < C.length by omega)]
