    (hL : ∀ a ∈ A, 3 ≤ a ∨ i₀ < a) (hRt : ∀ a ∈ A, a + 4 ≤ m ∨ a < i₀)
    (hM : ∀ a ∈ A, ∀ b ∈ A, a < b → a + 2 ≤ b ∧ (a + 4 ≤ b ∨ (a < i₀ ∧ i₀ < b))) :
    4 * A.card + 1 ≤ m := by
